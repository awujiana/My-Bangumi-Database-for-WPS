/*
@ 通知后端创建目录和页面文件
*/
function NewCustomNode(bFile, dirName, nodeName) {
    var xmlReq = new XMLHttpRequest();
    var serverHostIp = "http://10.13.76.111:9080/"
    let url;
    if (bFile === true) {
        url = serverHostIp + "newFile";
    } else {
        url = serverHostIp + "newDir";
    }
    xmlReq.open('POST', url);
    xmlReq.setRequestHeader('content-type', 'application/json');

    xmlReq.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
            var data = JSON.parse(xmlReq.responseText);
        }
    }

    let nodeInfo = {
        "dirName" : dirName,
        "nodeName" : nodeName
    }

    xmlReq.send(JSON.stringify(nodeInfo));
}


/*
@ 调用服务端接口
*/
function CallServerApi(apiName, para, callback) {
    var xmlReq = new XMLHttpRequest();
    var serverHostIp = "http://10.13.76.111:9080/"
    let url = serverHostIp + apiName
    xmlReq.open('POST', url);
    xmlReq.setRequestHeader('content-type', 'application/json');

    xmlReq.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
            var data = JSON.parse(xmlReq.responseText);
            callback(data)
        }
    }

    if (para === undefined) {
        xmlReq.send();
    } else {
        xmlReq.send(JSON.stringify(para));
    }
}

var elementOnEdit;
function popupContextMenu(e, ele) {
    let rm = document.getElementById("navRightMenu");
    console.log(ele);
    let xpos = e.pageX;
    let ypos = e.pageY;
    rm.style.left=xpos+"px";
    rm.style.top = ypos+"px";

    // 根据选择的是目录还是文件,要区别设置右键菜单
    let parentDiv = ele.parentElement.parentElement;
    let contextMenu = rm.children;

    switch(parentDiv.fileType) {
        case "normaldir" : // 普通目录，可进行所有操作
            for (let i = 0; i < contextMenu.length; i++) {
                contextMenu[i].style.display = "block";
            }
            rm.style.display = "block";
            break;
        case "apidir": // api目录，只能删除或者修改名字，下面不允许嵌套目录或者文件
            for (let i = 0; i < contextMenu.length; i++) {
                if (contextMenu[i].id == "idDelteNode" || contextMenu[i].id == "idRenameNode") {
                    contextMenu[i].style.display = "block";
                } else {
                    contextMenu[i].style.display = "none";
                }
            }
            rm.style.display = "block";
            break;
        case "apisubdir": // api子目录，不允许任何操作，在apidir上面进行操作
            for (let i = 0; i < contextMenu.length; i++) {
                contextMenu[i].style.display = "none";
            }
            rm.style.display = "none";
            break;
        case "apiessay": // api文章，不允许任何操作，在apidir上面进行操作
            for (let i = 0; i < contextMenu.length; i++) {
                contextMenu[i].style.display = "none";
            }
            rm.style.display = "none";
            break;
        case "essay": // 普通文章，只能删除或者修改名字
            for (let i = 0; i < contextMenu.length; i++) {
                if (contextMenu[i].id == "idDelteNode" || contextMenu[i].id == "idRenameNode") {
                    contextMenu[i].style.display = "block";
                } else {
                    contextMenu[i].style.display = "none";
                }
            }
            rm.style.display = "block";
            break;
        default:
            break;
    }

    elementOnEdit = ele;
    // 停止事件冒泡传播,这样其他的右键就不会生效了,比如body.oncontextmenu
    e.stopPropagation();
    return false;
}

