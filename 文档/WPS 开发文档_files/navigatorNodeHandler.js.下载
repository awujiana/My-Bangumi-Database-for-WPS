/*
@ 删除自定义节点，文章或者目录
*/ 
function delNode() {
hideContextMenu();
setTimeout(()=>{
    if (!confirm("确认要删除当前节点？")) {
        return;
    }
    var xmlReq = new XMLHttpRequest();
    var serverHostIp = "http://10.13.76.111:9080/"
    let url;
    var parentDiv = elementOnEdit.parentElement.parentElement;
    if (isItemDir(parentDiv.fileType)) {
        if (parentDiv.fileType === "apidir") {
            let para = {
                navPath : parentDiv.getAttribute("navPath")
            }
            return CallServerApi("delApiDir", para, ()=>{
                 // 删除页面节点元素
                parentDiv.parentElement.removeChild(parentDiv);
            })
        } else {
            url = serverHostIp + "delDir";
        }
        
    } else {
        url = serverHostIp + "delFile";
    }
    xmlReq.open('POST', url);
    xmlReq.setRequestHeader('content-type', 'application/json');

    xmlReq.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
        console.log("delnode success!")
        }
    }
    
    let nodeInfo = {
        "nodeName" : parentDiv.getAttribute("navPath")
    }
    
    xmlReq.send(JSON.stringify(nodeInfo));

    // 删除节点元素
    parentDiv.parentElement.removeChild(parentDiv);
}, 200);
}

