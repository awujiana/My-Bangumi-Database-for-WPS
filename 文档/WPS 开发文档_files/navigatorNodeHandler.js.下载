/*
@ 根据url获取模板文件连接地址,对于普通文件直接用nav.json中的href，对于api文件，解析成html+锚点的形式
*/
function GetTempleUrl(url, title, fileType) {
    // 普通文章， 直接使用文章链接，不用模板文件
    if (fileType === "essay") {
        if (url.endsWith("对象.htm") || url.endsWith("对象成员.htm") || url.endsWith("属性.htm") || url.endsWith("方法.htm") || url.endsWith("index.htm") || url.endsWith("index.html")) {
            return '"' + url + '"'
        }
    }

    // 注意url“对象”，“对象成员”前面都有一个空格
    if (url.endsWith("对象.htm")) { 
        let urlObj = url.replace("对象.htm", ".htm") // 去掉"对象"
        let objNameStart = urlObj.lastIndexOf("/");
        let objName = urlObj.substring(objNameStart + 1, urlObj.length - 5);
        let anchor = "#jsObject_" + objName
        return '"apiObjectTemplate.htm?page=' + urlObj + anchor + '"'
    } else if (url.endsWith("对象成员.htm")) {
        let urlObj = url.replace("对象成员.htm", ".htm") // 去掉"对象成员"
        let objNameStart = urlObj.lastIndexOf("/");
        let objName = urlObj.substring(objNameStart + 1, urlObj.length - 5);
        let anchor = "#jsMember_" + objName
        return '"apiObjectTemplate.htm?page=' + urlObj + anchor + '"'
    } else if (url.endsWith("属性.htm")) {
        let objNameEnd = url.lastIndexOf("/属性");
        let urlObj;
        if (objNameEnd === -1) {
            alert('invalid url');
        } else {
            let objNameStart = url.lastIndexOf("/", objNameEnd - 1)
            let objName = url.substring(objNameStart, objNameEnd)
            urlObj = url.substring(0, objNameEnd)
            urlObj += objName + " .htm"
        }
        let anchor = title.split(" ")[0];
        return '"apiObjectTemplate.htm?page=' + urlObj + "#" + anchor + '"';
    } else if (url.endsWith("方法.htm")) {
        let objNameEnd = url.lastIndexOf("/方法");
        let urlObj;
        if (objNameEnd === -1) {
            alert('invalid url');
        } else {
            let objNameStart = url.lastIndexOf("/", objNameEnd - 1)
            let objName = url.substring(objNameStart, objNameEnd)
            urlObj = url.substring(0, objNameEnd)
            urlObj += objName + " .htm"
        }
        let anchor = title.split(" ")[0];
        return '"apiObjectTemplate.htm?page=' + urlObj + "#" + anchor + '"';
    } else {
        return '"' + url + '"'
    }
}

/*
* 导航栏中增加一项
*/
function AddChild(node, data) {
    data.forEach(function(element) {
        var ele = document.createElement("div");
        ele.style.paddingLeft = "16px";
        // 项目文件类型，如果显式指定了，那么就是该类型；否则按照普通类型来处理
        let itemType = element.type;
        if (itemType === undefined) {
            itemType = element.fold ? "normaldir" : "essay"
        }
        
        ele.fileType = itemType;
        let navPath = node.getAttribute("navPath") + element.title + (isItemDir(itemType) ? "/" : "")
        ele.setAttribute("navPath", navPath)
        let href = (element.href === "#" ? "#" : node.getAttribute("navPath") + element.href);
        if (itemType === "apiessay" || itemType === "essay") {
            href = `topics/${href}`;
        }

        ele.innerHTML = '<jsbr><a href=' + GetTempleUrl(href, element.title, itemType) + '" onclick="return LinkClick(this, ' + 
            element.fold + ')" target="content" title="' + element.title + '" onmousemove="window.status="' +
            element.title + '"><img id="img3" src=' + (element.fold ? "icons/1.svg" : "icons/11.gif") +
            ' class="p"><span id="l1" class="unselected">' + element.title + '</span></a></jsbr>';
        
        node.appendChild(ele);
    });
}

function GetData(path, callback) {
    var xhr = new XMLHttpRequest();
    xhr.open("GET", location.href.slice(0, location.href.length - 19) + "navjson/" + path + "nav.json");
    xhr.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
            var data = JSON.parse(xhr.responseText);
            callback(data);
        }
    }
    xhr.send()
}

var curSelect;

/*
@  节点点击响应处理
*/
function LinkClick(cur, fold, callback) {
    if (!String.prototype.endsWith) {
        String.prototype.endsWith = function (suffix) {
            return this.indexOf(suffix, this.length - suffix.length) !== -1;
        };
    }
    if (curSelect) {
        curSelect.style.color = "#000000"
        curSelect.parentElement.style.backgroundColor = "#FFFFFF"
    }
    cur.style.color = "#409EFF";
    cur.parentElement.style.backgroundColor = "#E9F1FE"
    curSelect = cur;
    if (!fold)
        return true;

    var bShow = true;
    var img = cur.getElementsByTagName("img")[0];
    if (img) {
        if (img.src.endsWith("icons/1.svg")) {
            img.src = "icons/2.svg";
        } else {
            img.src = "icons/1.svg";
            bShow = false
        }
    }
    var node = cur.parentElement.parentElement;
    /*
        关掉其他的同等级目录的导航栏 
     */
    if (bShow ) { 
        let navEles = node.parentElement.children;
        for(let i = 0;i < navEles.length;i++) {
            let ele = navEles[i];
            if(ele != node && ele.nodeName != "JSBR" && isFolderExpanded(ele)) {
                ele.getElementsByTagName("img")[0].src = "icons/1.svg";
                for (var j = ele.childElementCount - 1; j > 0; --j){
                    ele.children[j].style.display = "none";
                }
            }
        }
    }
    node.setAttribute("navPath", node.parentElement.getAttribute("navPath") + cur.title + "/")
    if (bShow) {
        if (node.childElementCount == 1) {
            GetData(node.getAttribute("navPath"), function(data) {
                AddChild(node, data);
                if (callback) {
                    callback();
                }
            });
            return false;
        } else {
            for (var i = 1; i < node.childElementCount; ++i)
                node.children[i].style.display = "block";
        }
    } else {
        for (var i = 1; i < node.childElementCount; ++i)
            node.children[i].style.display = "none";
    }
    return false;
}




