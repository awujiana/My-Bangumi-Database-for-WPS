function isItemDir(type) {
    if (type === "apidir" || type === "apisubdir" || type === "normaldir") {
        return true;
    }

    return false;
}

/*
@ 当前文件夹是否处于展开状态，（可能曾经就展开过，也有可能没有展开）
*/
function isFoldExpand(aNode) {
    let img = aNode.getElementsByTagName("img")[0]
    if (img) {
        if (img.src.endsWith("icons/1.svg")) {
            return false;
        }
    }

    return true;
}

/*
@ 当前文件夹是否已经展开过
*/
function isFolderExpanded(divNode) {
    if (divNode && divNode.childElementCount === 1) {
        return false;
    }
    return true;
}