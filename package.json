{
  "name": "test",
  "addonType": "et",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:ts && vite --port 5173",
    "build": "vite build",
    "build:ts": "tsc --project tsconfig.build.json",
    "debug": "npm run build:ts && concurrently \"tsc --project tsconfig.build.json --watch\" \"wpsjs debug\"",
    "lint": "eslint ts tests --fix",
    "lint:check": "eslint ts tests",
    "check:dompurify-version": "node scripts/check-dompurify-version.mjs",
    "gate": "npm run lint:check && npm run check:dompurify-version && npm run test",
    "format": "prettier --write ts/ tests/",
    "format:check": "prettier --check ts/ tests/",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "description": "WPS Excel 加载项 - 追番标记助手",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "et-jsapi-declare": "latest",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "ts-declaration-location": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.9",
    "wpsjs": "latest"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "zod": "^4.4.3"
  }
}
