{
  "name": "my-bangumi-database-for-wps",
  "addonType": "et",
  "version": "2.2.4",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "npm run build:ts && vite --port 5173",
    "build": "npm run clean:ts && npm run build:ts && vite build",
    "build:ts": "tsc --project tsconfig.build.json",
    "clean:ts": "node scripts/clean-dist-ts.mjs",
    "debug": "npm run check:wpsjs-patch && npm run build:ts && concurrently \"tsc --project tsconfig.build.json --watch\" \"wpsjs debug\"",
    "lint": "eslint ts tests --fix",
    "lint:check": "eslint ts tests",
    "lint:stats": "node scripts/lint-stats.mjs",
    "lint:shadow": "eslint ts tests --config eslint.shadow.config.mjs --pass-on-unpruned-suppressions",
    "lint:shadow:json": "eslint ts tests --config eslint.shadow.config.mjs -f json -o .lint-shadow.json --pass-on-unpruned-suppressions",
    "check:dompurify-version": "node scripts/check-dompurify-version.mjs",
    "check:module-manifest": "node scripts/check-module-manifest.mjs",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "check:ribbon-buttons": "node scripts/check-ribbon-buttons.mjs",
    "check:nav-order": "node scripts/check-nav-order.mjs",
    "check:com-in-loop": "node scripts/check-com-in-loop.mjs",
    "check:detachable": "node scripts/check-detachable.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:wpsjs-patch": "node scripts/check-wpsjs-patch.mjs",
    "typecheck:tests": "node scripts/check-tests-types.mjs",
    "check:guards-reverse": "node scripts/verify-guards-reverse.mjs",
    "check:shard-layout": "node scripts/check-shard-layout.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "gate": "npm run lint:check && npm run check:dompurify-version && npm run check:module-manifest && npm run check:cycles && npm run check:ribbon-buttons && npm run check:nav-order && npm run check:com-in-loop && npm run check:detachable && npm run check:csp && npm run check:wpsjs-patch && npm run check:boot-com && npm run typecheck:tests && npm run test",
    "format": "prettier --write ts/ tests/",
    "format:check": "prettier --check ts/ tests/",
    "prepare": "husky && patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:boot-com": "node scripts/check-boot-com.mjs"
  },
  "description": "WPS Excel 加载项 - 追番标记助手",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.11",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "et-jsapi-declare": "^2.5.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "ts-declaration-location": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "wpsjs": "^2.2.3"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "zod": "^4.6.7"
  }
}
