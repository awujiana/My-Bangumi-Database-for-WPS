<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="wpsAddinTab" label="Bangumi同步">
				<group id="bangumiGroup" label="Bangumi">
                    <button id="btnShowPanel" label="打开同步面板" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnSyncBangumi" label="全面同步" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                     <!-- 新增复选框：跳过冲突 -->
                    <checkBox id="chkSkipConflicts" label="跳过冲突" getPressed="GetSkipConflictsPressed" onAction="OnSkipConflictsChange" />
                    <button id="btnSetToken" label="设置Token" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnTestToken" label="测试Token" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnSetUserId" label="设置用户ID" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnOpenCollection" label="打开收藏页" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnClearColors" label="清除标记" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
				</group>
            </tab>
        </tabs>
    </ribbon>
</customUI>