<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="wpsAddinTab" label="Bangumi同步">
				<group id="bangumiGroup" label="Bangumi">
                    <button id="btnShowPanel" label="打开同步面板" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnSyncBangumi" label="上传同步" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <checkBox id="chkIncrementalSync" label="仅同步变更" getPressed="GetIncrementalSyncPressed" onAction="OnIncrementalSyncChange" />
                    <checkBox id="chkSkipConflicts" label="跳过冲突" getPressed="GetSkipConflictsPressed" onAction="OnSkipConflictsChange" />
                    <checkBox id="chkEnableSyncRecord" label="启用同步记录" getPressed="GetEnableSyncRecordPressed" onAction="OnEnableSyncRecordChange" />
                    <button id="btnSetToken" label="设置Token" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnTestToken" label="测试Token" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnCopyToken" label="复制Token" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnSetUserId" label="设置用户ID" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnOpenCollection" label="打开收藏页" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnSyncFromGithub" label="数据同步" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnUndoLastSync" label="撤销同步" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnOpenSettings" label="设置" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                    <button id="btnCloseAllPanels" label="关闭所有页面" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                  
				</group>
				<group id="enrichGroup" label="新番表富化">
                    <button id="btnOpenEnrichPanel" label="新番表富化" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                </group>
				<group id="cleanGroup" label="数据清理">
                    <button id="btnOpenCleanPanel" label="数据清理" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                </group>
				<group id="highlightGroup" label="番剧高亮">
                    <button id="btnOpenHighlightPanel" label="番剧高亮" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                </group>
				<group id="conditionalFormatGroup" label="条件格式">
                    <button id="btnOpenConditionalFormatPanel" label="条件格式管理" onAction="OnAction" getImage="GetBangumiImage" size="large"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>