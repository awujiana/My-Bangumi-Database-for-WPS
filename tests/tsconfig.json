{
  // ========== 测试目录专属 TS Project ==========
  // 存在理由：根 tsconfig.json 的 rootDir 固定为 "ts/"，无法把 tests/ 并入 include
  // （tests/ 位于 rootDir 之外，纳入后会触发 TS6059）。而 typescript-eslint 的
  // projectService 需要每个被检查的文件都归属于某个 TS Project，否则报
  // "was not found by the project service" 解析错误、整份文件被跳过检查。
  // 实测：缺失本文件时 tests/ 下 43 个文件全部未经 lint（静默漏检）。
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // rootDir 必须覆盖根配置的 "ts/" 并上提到项目根：
    // 本 project 同时包含 tests/ 与经 import 图拉入的 ts/ 源码，
    // 若设为 "." 则 ts/ 落在 rootDir 之外触发 TS6059（已实测）。
    "rootDir": "..",
    "noEmit": true, // 本 project 仅供类型检查与 lint，不产出任何文件
    "sourceMap": false, // 不产出时无需 map
    "declaration": false
  },
  // 测试文件全部显式 `import { ... } from 'vitest'`，无需 types: ["vitest/globals"]；
  // 被测源码经 import 图自动纳入本 project，不必显式 include ../ts/。
  "include": ["./**/*.ts"]
}
