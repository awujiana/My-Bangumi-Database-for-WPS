{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./generated-types",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "./generated-types",
    "sourceMap": false,
    "noEmitOnError": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,

    "ignoreDeprecations": "6.0"
  },
  "include": [
    "ts/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-ts",
    "generated-types",
    "**/*.spec.ts"
  ]
}