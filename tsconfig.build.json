{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-ts",  // 将编译输出放到单独的目录
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "./generated-types",  // 声明文件放在./generated-types"目录
    "sourceMap": false,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-ts",  // 排除输出目录
    "**/*.spec.ts"
  ]
}