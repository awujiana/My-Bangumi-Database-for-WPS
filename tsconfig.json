{
  "compilerOptions": {
    // ========== 编译目标 ==========
    "target": "ES2022",                        // 编译到 ES2022，支持现代浏览器和 WPS
    "module": "ESNext",                        // 使用 ES Module 输出（支持 import/export）
    "moduleResolution": "bundler",             // 使用 bundler 模式解析模块（适合 Vite/Webpack）
    "lib": ["ES2022", "DOM", "DOM.Iterable"],  // 包含 ES2022 + 浏览器 DOM API

    // ========== 类型检查严格性 ==========
    "strict": true,                            // 开启所有严格检查
    "noImplicitAny": true,                     // 禁止隐式 any 类型
    "strictNullChecks": true,                  // 严格 null/undefined 检查
    "strictFunctionTypes": true,               // 严格函数类型检查
    "noUncheckedIndexedAccess": true,          // 访问数组/对象索引时返回 T | undefined
    "exactOptionalPropertyTypes": true,        // 可选属性不能赋值为 undefined
    "useUnknownInCatchVariables": true,        // catch 变量为 unknown 类型
    "noUnusedLocals": false,                   // 不报告未使用的局部变量（开发阶段宽松）
    "noUnusedParameters": false,               // 不报告未使用的参数
    "noImplicitReturns": true,                 // 函数必须有明确的返回值
    "noFallthroughCasesInSwitch": true,        // switch 中不允许贯穿

    // ========== 模块解析 ==========
    "esModuleInterop": true,                   // 允许 import cjs 模块为默认导入
    "skipLibCheck": true,                      // 跳过 .d.ts 类型检查，加快编译
    "forceConsistentCasingInFileNames": true,  // 强制文件名大小写一致

    // ========== 输出配置 ==========
    "declaration": false,                      // 不生成 .d.ts 声明文件（由 build 配置控制）
    "declarationMap": false,                   // 不生成声明文件的 source map
    "sourceMap": true,                         // 生成 .js.map 方便调试
    "outDir": "./dist-ts",                     // TS 编译输出目录
    "rootDir": "ts/",                            // 源文件根目录（项目根）【关键】

    // ========== 路径别名 ==========
    "baseUrl": ".",                            // 基础路径
    "resolveJsonModule": true,                 // 允许导入 .json 文件
    "isolatedModules": true,                   // 每个文件独立编译（安全）
    "allowSyntheticDefaultImports": true,      // 允许默认导入无 default 的模块
    "allowJs": false,                           // 允许 TS 文件导入 JS 文件【关键】

    // ========== 类型查找路径 ==========
    "typeRoots": [
      "./node_modules/@types",                 // npm 安装的类型包
      "./dist-ts/ts",                     // 上次编译生成的 .d.ts
    ],
    "types": [],                               // 不自动包含任何 @types 包
    "ignoreDeprecations": "6.0"                // 忽略 6.0 版本的废弃警告
  },
  // ========== 包含的源文件 ==========
  "include": ["ts/"],                         // 只编译 ts/ 根目录下的 .ts 文件
  // ========== 排除的目录 ==========
  "exclude": [
    "node_modules",                            // 依赖包
    "dist",                                    // Vite 构建产物
    "dist-ts",                                 // 自己的编译产物
                                               // 声明文件输出
    "**/*.spec.ts"                             // 测试文件
  ]
}